# Copy this file to .env and adjust as needed. docker-compose.yml falls
# back to the defaults shown here if .env is missing entirely.

# How long (in seconds) a cached answer stays in Redis before expiring.
CACHE_TTL_SECONDS=300

# Internal URL the gateway uses to reach the mock LLM service.
MOCK_LLM_URL=http://mock-llm:8001

# Hostname of the Redis service, as seen on the internal compose network.
REDIS_HOST=redis
